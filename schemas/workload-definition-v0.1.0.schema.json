{
  "$defs": {
    "WorkloadCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "expected_output_token_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Output Token Count"
        },
        "prompt": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "prompt"
      ],
      "title": "WorkloadCase",
      "type": "object"
    },
    "WorkloadOrdering": {
      "enum": [
        "DECLARED",
        "SORTED_CASE_ID"
      ],
      "title": "WorkloadOrdering",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/WorkloadCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "description": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "ordering_policy": {
      "$ref": "#/$defs/WorkloadOrdering"
    },
    "prompt_transformation": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Prompt Transformation",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "name",
    "description",
    "ordering_policy",
    "prompt_transformation",
    "cases"
  ],
  "title": "WorkloadDefinition",
  "type": "object"
}
