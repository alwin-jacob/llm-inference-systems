{
  "$defs": {
    "CancellationClassification": {
      "enum": [
        "SERVER_ABORT_ACKNOWLEDGED_AND_DRAINED",
        "UNKNOWN_ACKNOWLEDGEMENT",
        "LATER_COMPLETION",
        "RESIDUAL_WORK_TIMEOUT",
        "TERMINAL_UNKNOWN",
        "ID_CORRELATION_FAILURE"
      ],
      "title": "CancellationClassification",
      "type": "string"
    },
    "CancellationProbe": {
      "additionalProperties": false,
      "properties": {
        "client_close_offset_ns": {
          "minimum": 0,
          "title": "Client Close Offset Ns",
          "type": "integer"
        },
        "cooldown_snapshots": {
          "items": {
            "$ref": "#/$defs/PrometheusSnapshot"
          },
          "minItems": 2,
          "title": "Cooldown Snapshots",
          "type": "array"
        },
        "dispatch_offset_ns": {
          "minimum": 0,
          "title": "Dispatch Offset Ns",
          "type": "integer"
        },
        "drain_snapshots": {
          "items": {
            "$ref": "#/$defs/PrometheusSnapshot"
          },
          "maxItems": 10,
          "minItems": 10,
          "title": "Drain Snapshots",
          "type": "array"
        },
        "first_generation_token": {
          "$ref": "#/$defs/FirstGenerationTokenEvidence"
        },
        "identity_chain": {
          "$ref": "#/$defs/RequestIdentityChain"
        },
        "later_retained_snapshots": {
          "items": {
            "$ref": "#/$defs/PrometheusSnapshot"
          },
          "title": "Later Retained Snapshots",
          "type": "array"
        },
        "pre_dispatch_snapshots": {
          "items": {
            "$ref": "#/$defs/PrometheusSnapshot"
          },
          "maxItems": 10,
          "minItems": 10,
          "title": "Pre Dispatch Snapshots",
          "type": "array"
        },
        "raw_log_start_byte_offset": {
          "minimum": 0,
          "title": "Raw Log Start Byte Offset",
          "type": "integer"
        },
        "residual_state": {
          "$ref": "#/$defs/ResidualStateEvidence"
        },
        "stable_generation_snapshots": {
          "items": {
            "$ref": "#/$defs/PrometheusSnapshot"
          },
          "minItems": 2,
          "title": "Stable Generation Snapshots",
          "type": "array"
        }
      },
      "required": [
        "identity_chain",
        "raw_log_start_byte_offset",
        "dispatch_offset_ns",
        "first_generation_token",
        "client_close_offset_ns",
        "pre_dispatch_snapshots",
        "drain_snapshots",
        "stable_generation_snapshots",
        "cooldown_snapshots",
        "later_retained_snapshots",
        "residual_state"
      ],
      "title": "CancellationProbe",
      "type": "object"
    },
    "CancellationResult": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "auxiliary_counter_deltas": {
          "items": {
            "$ref": "#/$defs/CounterDelta"
          },
          "title": "Auxiliary Counter Deltas",
          "type": "array"
        },
        "classification": {
          "$ref": "#/$defs/CancellationClassification"
        },
        "evidence_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Identity Sha256",
          "type": "string"
        },
        "finished_reason_deltas": {
          "items": {
            "$ref": "#/$defs/CounterDelta"
          },
          "title": "Finished Reason Deltas",
          "type": "array"
        },
        "generation_token_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/CounterDelta"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_abort_delta": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Abort Delta"
        },
        "prompt_token_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/CounterDelta"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "classification",
        "accepted",
        "evidence_identity_sha256",
        "prompt_token_delta",
        "generation_token_delta",
        "finished_reason_deltas",
        "auxiliary_counter_deltas",
        "observed_abort_delta"
      ],
      "title": "CancellationResult",
      "type": "object"
    },
    "CounterDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "minimum": 0,
          "title": "After",
          "type": "number"
        },
        "before": {
          "minimum": 0,
          "title": "Before",
          "type": "number"
        },
        "delta": {
          "minimum": 0,
          "title": "Delta",
          "type": "number"
        },
        "labels": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Labels",
          "type": "array"
        },
        "metric": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "labels",
        "before",
        "after",
        "delta"
      ],
      "title": "CounterDelta",
      "type": "object"
    },
    "FirstGenerationTokenEvidence": {
      "additionalProperties": false,
      "properties": {
        "external_request_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "External Request Id",
          "type": "string"
        },
        "observation_offset_ns": {
          "minimum": 0,
          "title": "Observation Offset Ns",
          "type": "integer"
        },
        "output_token_ids": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Output Token Ids",
          "type": "array"
        },
        "response_body_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Response Body Id",
          "type": "string"
        }
      },
      "required": [
        "external_request_id",
        "response_body_id",
        "observation_offset_ns",
        "output_token_ids"
      ],
      "title": "FirstGenerationTokenEvidence",
      "type": "object"
    },
    "GpuMemorySample": {
      "additionalProperties": false,
      "properties": {
        "allocated_bytes": {
          "minimum": 0,
          "title": "Allocated Bytes",
          "type": "integer"
        },
        "observation_offset_ns": {
          "minimum": 0,
          "title": "Observation Offset Ns",
          "type": "integer"
        }
      },
      "required": [
        "observation_offset_ns",
        "allocated_bytes"
      ],
      "title": "GpuMemorySample",
      "type": "object"
    },
    "ProcessExitEvidence": {
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "const": 0,
          "title": "Exit Code",
          "type": "integer"
        },
        "observed_offset_ns": {
          "minimum": 0,
          "title": "Observed Offset Ns",
          "type": "integer"
        },
        "process_identity": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Process Identity",
          "type": "string"
        },
        "raw_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Evidence Sha256",
          "type": "string"
        }
      },
      "required": [
        "process_identity",
        "exit_code",
        "observed_offset_ns",
        "raw_evidence_sha256"
      ],
      "title": "ProcessExitEvidence",
      "type": "object"
    },
    "PrometheusSample": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Labels",
          "type": "array"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "labels",
        "value"
      ],
      "title": "PrometheusSample",
      "type": "object"
    },
    "PrometheusSnapshot": {
      "additionalProperties": false,
      "properties": {
        "label_inventory": {
          "additionalProperties": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Label Inventory",
          "type": "object"
        },
        "process_start_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Process Start Id",
          "type": "string"
        },
        "raw_exposition": {
          "title": "Raw Exposition",
          "type": "string"
        },
        "raw_exposition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Exposition Sha256",
          "type": "string"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/PrometheusSample"
          },
          "title": "Samples",
          "type": "array"
        },
        "scrape_monotonic_offset_ns": {
          "minimum": 0,
          "title": "Scrape Monotonic Offset Ns",
          "type": "integer"
        },
        "scrape_wall_clock_utc": {
          "format": "date-time",
          "title": "Scrape Wall Clock Utc",
          "type": "string"
        }
      },
      "required": [
        "process_start_id",
        "scrape_wall_clock_utc",
        "scrape_monotonic_offset_ns",
        "raw_exposition",
        "raw_exposition_sha256",
        "samples",
        "label_inventory"
      ],
      "title": "PrometheusSnapshot",
      "type": "object"
    },
    "RawLogRecord": {
      "additionalProperties": false,
      "properties": {
        "byte_end": {
          "exclusiveMinimum": 0,
          "title": "Byte End",
          "type": "integer"
        },
        "byte_start": {
          "minimum": 0,
          "title": "Byte Start",
          "type": "integer"
        },
        "observation_offset_ns": {
          "minimum": 0,
          "title": "Observation Offset Ns",
          "type": "integer"
        },
        "raw_record": {
          "title": "Raw Record",
          "type": "string"
        },
        "raw_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Record Sha256",
          "type": "string"
        },
        "record_ordinal": {
          "minimum": 0,
          "title": "Record Ordinal",
          "type": "integer"
        },
        "source_stream_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Stream Id",
          "type": "string"
        }
      },
      "required": [
        "source_stream_id",
        "record_ordinal",
        "byte_start",
        "byte_end",
        "observation_offset_ns",
        "raw_record",
        "raw_record_sha256"
      ],
      "title": "RawLogRecord",
      "type": "object"
    },
    "RequestIdentityChain": {
      "additionalProperties": false,
      "properties": {
        "external_abort_log": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawLogRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_base_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "External Base Id",
          "type": "string"
        },
        "internal_abort_log": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawLogRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "internal_engine_id": {
          "title": "Internal Engine Id",
          "type": "string"
        },
        "request_add_log": {
          "$ref": "#/$defs/RawLogRecord"
        },
        "request_received_log": {
          "$ref": "#/$defs/RawLogRecord"
        },
        "response_body_id": {
          "title": "Response Body Id",
          "type": "string"
        },
        "serving_item_id": {
          "title": "Serving Item Id",
          "type": "string"
        }
      },
      "required": [
        "external_base_id",
        "response_body_id",
        "serving_item_id",
        "internal_engine_id",
        "request_received_log",
        "request_add_log",
        "external_abort_log",
        "internal_abort_log"
      ],
      "title": "RequestIdentityChain",
      "type": "object"
    },
    "ResidualStateEvidence": {
      "additionalProperties": false,
      "properties": {
        "active_request_ids": {
          "items": {
            "type": "string"
          },
          "title": "Active Request Ids",
          "type": "array"
        },
        "observation_offset_ns": {
          "minimum": 0,
          "title": "Observation Offset Ns",
          "type": "integer"
        },
        "project_process_ids": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Project Process Ids",
          "type": "array"
        },
        "raw_process_inventory": {
          "title": "Raw Process Inventory",
          "type": "string"
        },
        "raw_process_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Process Inventory Sha256",
          "type": "string"
        }
      },
      "required": [
        "observation_offset_ns",
        "raw_process_inventory",
        "raw_process_inventory_sha256",
        "active_request_ids",
        "project_process_ids"
      ],
      "title": "ResidualStateEvidence",
      "type": "object"
    },
    "RuntimePhase": {
      "enum": [
        "LIVE_RESOURCE_AUDIT",
        "ENVIRONMENT_LOCK_VERIFICATION",
        "OFFLINE_SNAPSHOT_VERIFICATION",
        "RUNTIME_PROCESS_START",
        "MODEL_WEIGHT_LOAD",
        "ENGINE_READINESS_HEALTH",
        "JIT_COMPILATION_STATE",
        "CUDA_GRAPH_STATE",
        "ALLOCATOR_KV_STABILIZATION",
        "EXCLUDED_STABILIZATION_REQUESTS",
        "EXCLUDED_SHAPE_WARMUPS",
        "CANCELLATION_PROBE_DRAIN",
        "STEADY_STATE_GATE",
        "MEASURED_WINDOW",
        "FINAL_METRICS_DRAIN",
        "SHUTDOWN",
        "NO_RESIDUAL_PROCESS_VERIFICATION"
      ],
      "title": "RuntimePhase",
      "type": "string"
    },
    "RuntimePhaseRecord": {
      "additionalProperties": false,
      "properties": {
        "ended_offset_ns": {
          "minimum": 0,
          "title": "Ended Offset Ns",
          "type": "integer"
        },
        "evidence_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Identity Sha256",
          "type": "string"
        },
        "evidence_kind": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evidence Kind",
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "passed": {
          "const": true,
          "title": "Passed",
          "type": "boolean"
        },
        "phase": {
          "$ref": "#/$defs/RuntimePhase"
        },
        "post_warmup_jit_observed": {
          "default": false,
          "title": "Post Warmup Jit Observed",
          "type": "boolean"
        },
        "started_offset_ns": {
          "minimum": 0,
          "title": "Started Offset Ns",
          "type": "integer"
        }
      },
      "required": [
        "phase",
        "started_offset_ns",
        "ended_offset_ns",
        "passed",
        "evidence_kind",
        "evidence_identity_sha256",
        "evidence_references"
      ],
      "title": "RuntimePhaseRecord",
      "type": "object"
    },
    "Stage2ProcessKind": {
      "enum": [
        "ONLINE_SNAPSHOT_DOWNLOAD",
        "OFFLINE_TOKENIZER_VERIFICATION",
        "OFFLINE_VLLM_RESTART_1",
        "OFFLINE_VLLM_RESTART_2",
        "OFFLINE_VLLM_RESTART_3"
      ],
      "title": "Stage2ProcessKind",
      "type": "string"
    },
    "Stage2ProcessOperation": {
      "additionalProperties": false,
      "properties": {
        "exact_network_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exact Network Source"
        },
        "exits_after_operation": {
          "title": "Exits After Operation",
          "type": "boolean"
        },
        "local_files_only": {
          "title": "Local Files Only",
          "type": "boolean"
        },
        "repository_id": {
          "anyOf": [
            {
              "const": "Qwen/Qwen2.5-0.5B-Instruct",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Repository Id"
        },
        "revision": {
          "anyOf": [
            {
              "const": "7ae557604adf67be50417f59c2c2f167def9a775",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision"
        },
        "token_false": {
          "title": "Token False",
          "type": "boolean"
        },
        "verified_local_snapshot_path": {
          "title": "Verified Local Snapshot Path",
          "type": "string"
        }
      },
      "required": [
        "token_false",
        "local_files_only",
        "repository_id",
        "revision",
        "exact_network_source",
        "verified_local_snapshot_path",
        "exits_after_operation"
      ],
      "title": "Stage2ProcessOperation",
      "type": "object"
    },
    "Stage2ProcessRecord": {
      "additionalProperties": false,
      "properties": {
        "absent_environment_variables": {
          "items": {
            "type": "string"
          },
          "title": "Absent Environment Variables",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "environment_capture_offset_ns": {
          "minimum": 0,
          "title": "Environment Capture Offset Ns",
          "type": "integer"
        },
        "first_relevant_import_offset_ns": {
          "exclusiveMinimum": 0,
          "title": "First Relevant Import Offset Ns",
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/Stage2ProcessOperation"
        },
        "process_identity": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Process Identity",
          "type": "string"
        },
        "process_kind": {
          "$ref": "#/$defs/Stage2ProcessKind"
        },
        "process_start_offset_ns": {
          "minimum": 0,
          "title": "Process Start Offset Ns",
          "type": "integer"
        }
      },
      "required": [
        "process_kind",
        "process_identity",
        "process_start_offset_ns",
        "environment_capture_offset_ns",
        "first_relevant_import_offset_ns",
        "environment",
        "absent_environment_variables",
        "operation"
      ],
      "title": "Stage2ProcessRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cancellation_probe": {
      "$ref": "#/$defs/CancellationProbe"
    },
    "cancellation_result": {
      "$ref": "#/$defs/CancellationResult"
    },
    "final_metric_scrape": {
      "$ref": "#/$defs/PrometheusSnapshot"
    },
    "gpu_memory_samples": {
      "items": {
        "$ref": "#/$defs/GpuMemorySample"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Gpu Memory Samples",
      "type": "array"
    },
    "gpu_memory_tolerance_bytes": {
      "minimum": 0,
      "title": "Gpu Memory Tolerance Bytes",
      "type": "integer"
    },
    "measured_client_slot_assignments": {
      "items": {
        "enum": [
          0,
          1
        ],
        "type": "integer"
      },
      "maxItems": 16,
      "minItems": 16,
      "title": "Measured Client Slot Assignments",
      "type": "array"
    },
    "measured_request_count": {
      "const": 16,
      "title": "Measured Request Count",
      "type": "integer"
    },
    "measured_request_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 16,
      "title": "Measured Request Ids",
      "type": "array"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/RuntimePhaseRecord"
      },
      "title": "Phases",
      "type": "array"
    },
    "post_warmup_jit_event_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Post Warmup Jit Event Hashes",
      "type": "array"
    },
    "prefix_cache_hit_delta": {
      "$ref": "#/$defs/CounterDelta"
    },
    "prefix_cache_query_delta": {
      "$ref": "#/$defs/CounterDelta"
    },
    "process_records": {
      "items": {
        "$ref": "#/$defs/Stage2ProcessRecord"
      },
      "title": "Process Records",
      "type": "array"
    },
    "quiet_interval_end_offset_ns": {
      "minimum": 0,
      "title": "Quiet Interval End Offset Ns",
      "type": "integer"
    },
    "quiet_interval_start_offset_ns": {
      "minimum": 0,
      "title": "Quiet Interval Start Offset Ns",
      "type": "integer"
    },
    "repetition_index": {
      "maximum": 3,
      "minimum": 1,
      "title": "Repetition Index",
      "type": "integer"
    },
    "requested_client_concurrency": {
      "const": 2,
      "title": "Requested Client Concurrency",
      "type": "integer"
    },
    "residual_active_request_ids": {
      "items": {
        "type": "string"
      },
      "title": "Residual Active Request Ids",
      "type": "array"
    },
    "residual_process_ids": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Residual Process Ids",
      "type": "array"
    },
    "residual_verification_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Residual Verification Evidence Sha256",
      "type": "string"
    },
    "residual_verification_offset_ns": {
      "minimum": 0,
      "title": "Residual Verification Offset Ns",
      "type": "integer"
    },
    "shutdown_processes": {
      "items": {
        "$ref": "#/$defs/ProcessExitEvidence"
