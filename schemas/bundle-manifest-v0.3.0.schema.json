{
  "$defs": {
    "BundleFileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "BundleFileEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/BundleFileEntry"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "measurement_protocol_version": {
      "const": "0.3.0",
      "title": "Measurement Protocol Version",
      "type": "string"
    },
    "reconstruction_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reconstruction Sha256",
      "type": "string"
    },
    "repetition_index": {
      "maximum": 3,
      "minimum": 1,
      "title": "Repetition Index",
      "type": "integer"
    },
    "schema_version": {
      "const": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "state": {
      "const": "COMMITTED",
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "measurement_protocol_version",
    "state",
    "repetition_index",
    "source_commit",
    "created_at_utc",
    "files",
    "reconstruction_sha256"
  ],
  "title": "Stage2BundleManifest",
  "type": "object"
}
