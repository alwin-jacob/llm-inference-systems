{
  "$defs": {
    "BundleFileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "BundleFileEntry",
      "type": "object"
    },
    "Stage2EvidenceBoundary": {
      "additionalProperties": false,
      "properties": {
        "cuda_execution": {
          "title": "Cuda Execution",
          "type": "boolean"
        },
        "evidence_scope": {
          "$ref": "#/$defs/Stage2EvidenceScope"
        },
        "gpu_execution": {
          "title": "Gpu Execution",
          "type": "boolean"
        },
        "historical_authentication_effect": {
          "const": "NONE",
          "default": "NONE",
          "title": "Historical Authentication Effect",
          "type": "string"
        },
        "model_execution": {
          "title": "Model Execution",
          "type": "boolean"
        },
        "public_claim_advancement": {
          "const": false,
          "default": false,
          "title": "Public Claim Advancement",
          "type": "boolean"
        },
        "real_runtime_execution": {
          "title": "Real Runtime Execution",
          "type": "boolean"
        },
        "stage2a_cpu_fixture_tested": {
          "title": "Stage2A Cpu Fixture Tested",
          "type": "boolean"
        },
        "tokenizer_execution": {
          "title": "Tokenizer Execution",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_scope",
        "stage2a_cpu_fixture_tested",
        "real_runtime_execution",
        "model_execution",
        "tokenizer_execution",
        "gpu_execution",
        "cuda_execution"
      ],
      "title": "Stage2EvidenceBoundary",
      "type": "object"
    },
    "Stage2EvidenceScope": {
      "enum": [
        "TEST_FIXTURE_ONLY",
        "FUTURE_REAL_RUNTIME"
      ],
      "title": "Stage2EvidenceScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "boundary": {
      "$ref": "#/$defs/Stage2EvidenceBoundary"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/BundleFileEntry"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "measurement_protocol_version": {
      "const": "0.3.0",
      "title": "Measurement Protocol Version",
      "type": "string"
    },
    "reconstruction_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reconstruction Sha256",
      "type": "string"
    },
    "repetition_index": {
      "maximum": 3,
      "minimum": 1,
      "title": "Repetition Index",
      "type": "integer"
    },
    "schema_version": {
      "const": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "state": {
      "const": "COMMITTED",
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "measurement_protocol_version",
    "state",
    "boundary",
    "repetition_index",
    "source_commit",
    "created_at_utc",
    "files",
    "reconstruction_sha256"
  ],
  "title": "Stage2BundleManifest",
  "type": "object"
}
