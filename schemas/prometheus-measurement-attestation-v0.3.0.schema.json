          "minimum": 0,
          "title": "Response Body Completion Observation Offset Ns",
          "type": "integer"
        },
        "response_body_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Inventory Sha256",
          "type": "string"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "response_content_type_parameters": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Response Content Type Parameters",
          "type": "array"
        },
        "response_header_capture_complete_at_layer": {
          "const": true,
          "title": "Response Header Capture Complete At Layer",
          "type": "boolean"
        },
        "response_header_count": {
          "minimum": 0,
          "title": "Response Header Count",
          "type": "integer"
        },
        "response_header_observation_offset_ns": {
          "minimum": 0,
          "title": "Response Header Observation Offset Ns",
          "type": "integer"
        },
        "response_headers": {
          "$ref": "#/$defs/Stage2OrderedHeadersCapture"
        },
        "response_status": {
          "const": 200,
          "title": "Response Status",
          "type": "integer"
        },
        "schema_version": {
          "const": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scheme": {
          "const": "http",
          "title": "Scheme",
          "type": "string"
        },
        "server_process_identity": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Server Process Identity",
          "type": "string"
        },
        "transport_terminal_classification": {
          "enum": [
            "CLEAN_EOF",
            "CLEAN_RESPONSE_CLOSE",
            "INTENTIONAL_CLIENT_CLOSE_AFTER_FIRST_GENERATION_DELIVERY"
