        "requested_http_version": {
          "const": "HTTP/1.1",
          "title": "Requested Http Version",
          "type": "string"
        },
        "requested_http_version_source": {
          "const": "HTTPX_CLIENT_CONFIGURATION_HTTP2_FALSE",
