        "response_body_byte_count": {
          "minimum": 0,
          "title": "Response Body Byte Count",
          "type": "integer"
        },
        "response_body_capture_complete_through_terminal_at_layer": {
          "const": true,
          "title": "Response Body Capture Complete Through Terminal At Layer",
          "type": "boolean"
