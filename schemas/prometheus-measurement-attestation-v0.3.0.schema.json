    "PrometheusRawScrapeCapture": {
      "additionalProperties": false,
      "description": "Lossless collector boundary for one raw Prometheus exposition scrape.",
      "properties": {
        "boundary": {
          "enum": [
            "baseline",
            "final"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "capture_source": {
          "enum": [
            "TEST_FIXTURE_ONLY_CPU_SCRAPE",
            "FUTURE_RUNTIME_PROMETHEUS_COLLECTOR"
          ],
          "title": "Capture Source",
          "type": "string"
        },
        "decoded_byte_count": {
          "minimum": 0,
          "title": "Decoded Byte Count",
          "type": "integer"
        },
        "evidence_scope": {
          "$ref": "#/$defs/Stage2EvidenceScope"
        },
        "http_exchange": {
          "$ref": "#/$defs/Stage2HTTPExchangeCapture"
        },
        "identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        },
        "process_start_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Process Start Id",
          "type": "string"
        },
        "provenance": {
          "discriminator": {
            "mapping": {
              "COLLECTOR_CAPTURE": "#/$defs/CollectorWireCaptureProvenance",
              "FIXTURE_CONSTRUCTOR": "#/$defs/FixtureWireCaptureProvenance"
            },
            "propertyName": "capture_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixtureWireCaptureProvenance"
            },
            {
              "$ref": "#/$defs/CollectorWireCaptureProvenance"
            }
          ],
          "title": "Provenance"
        },
        "raw_exposition_base64": {
          "title": "Raw Exposition Base64",
          "type": "string"
        },
        "raw_exposition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Exposition Sha256",
          "type": "string"
        },
        "repetition_index": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Repetition Index",
          "type": "integer"
        },
        "schema_version": {
          "const": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scrape_monotonic_offset_ns": {
          "minimum": 0,
          "title": "Scrape Monotonic Offset Ns",
          "type": "integer"
        },
        "scrape_wall_clock_utc": {
          "format": "date-time",
          "title": "Scrape Wall Clock Utc",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "evidence_scope",
        "repetition_index",
        "boundary",
        "process_start_id",
        "scrape_wall_clock_utc",
        "scrape_monotonic_offset_ns",
        "raw_exposition_base64",
        "decoded_byte_count",
        "raw_exposition_sha256",
        "capture_source",
        "provenance",
        "http_exchange",
        "identity_sha256"
      ],
      "title": "PrometheusRawScrapeCapture",
      "type": "object"
    },
