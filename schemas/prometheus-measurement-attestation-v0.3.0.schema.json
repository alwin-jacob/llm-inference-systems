        "classification": {
          "const": "FUTURE_REAL_RUNTIME",
          "title": "Classification",
          "type": "string"
        },
        "collector_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Collector Identity Sha256",
          "type": "string"
        },
        "environment_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Identity Sha256",
          "type": "string"
        },
        "evidence_scope": {
          "const": "FUTURE_REAL_RUNTIME",
          "title": "Evidence Scope",
          "type": "string"
        },
        "identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        },
        "model_snapshot_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Snapshot Identity Sha256",
          "type": "string"
        },
        "server_process_identity": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Server Process Identity",
          "type": "string"
        }
      },
      "required": [
        "capture_kind",
        "evidence_scope",
        "classification",
        "collector_identity_sha256",
        "server_process_identity",
        "model_snapshot_identity_sha256",
        "environment_identity_sha256",
        "identity_sha256"
