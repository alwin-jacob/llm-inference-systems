    "Stage2HTTPExchangeCapture": {
      "additionalProperties": false,
      "description": "Complete exchange identity at the explicitly declared HTTPX layer.",
      "properties": {
        "capture_layer": {
          "const": "HTTPX_REQUEST_RESPONSE_OBJECTS_HEADERS_AND_AITER_RAW_BODY_CHUNKS",
