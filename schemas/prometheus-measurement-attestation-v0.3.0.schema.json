        "measurement_protocol_version",
        "exchange_purpose",
        "repetition_index",
        "evidence_unit_id",
        "external_request_id",
        "capture_layer",
        "provenance",
        "method",
        "scheme",
        "host",
        "port",
        "request_target",
        "requested_http_version",
        "requested_http_version_source",
        "observed_response_http_version",
        "observed_response_http_version_source",
        "response_status",
        "request_headers",
        "response_headers",
        "request_header_count",
        "response_header_count",
        "request_header_capture_complete_at_layer",
        "response_header_capture_complete_at_layer",
        "full_response_content_type",
        "normalized_response_media_type",
        "response_content_type_parameters",
        "request_body_transmission_observation_offset_ns",
        "response_header_observation_offset_ns",
        "request_body_byte_count",
        "request_body_sha256",
        "response_body_byte_count",
        "response_body_sha256",
        "response_body_inventory_sha256",
        "response_body_completion_observation_offset_ns",
        "transport_terminal_observation_offset_ns",
        "transport_terminal_classification",
        "response_body_capture_complete_through_terminal_at_layer",
        "server_process_identity",
        "launch_spec_identity_sha256",
        "identity_sha256"
      ],
      "title": "Stage2HTTPExchangeCapture",
      "type": "object"
