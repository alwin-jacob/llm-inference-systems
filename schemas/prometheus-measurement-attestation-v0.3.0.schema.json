          "type": "string"
        },
        "exchange_purpose": {
          "enum": [
            "MEASURED_COMPLETION",
            "CANCELLATION",
            "PROMETHEUS_BASELINE",
            "PROMETHEUS_FINAL"
          ],
          "title": "Exchange Purpose",
          "type": "string"
        },
        "external_request_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
