    "read_only_transition": {
      "$ref": "#/$defs/SnapshotReadOnlyTransition"
    },
    "repository": {
      "const": "Qwen/Qwen2.5-0.5B-Instruct",
      "title": "Repository",
      "type": "string"
    },
    "required_file_allowlist": {
      "items": {
        "type": "string"
      },
      "title": "Required File Allowlist",
      "type": "array"
    },
    "revision": {
      "const": "7ae557604adf67be50417f59c2c2f167def9a775",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_root_identity_sha256": {
