{
  "$defs": {
    "SnapshotFileEntry": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "entry_type": {
          "const": "regular_file",
          "title": "Entry Type",
          "type": "string"
        },
        "observed_byte_size": {
          "minimum": 0,
          "title": "Observed Byte Size",
          "type": "integer"
        },
        "observed_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observed Sha256",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "entry_type",
        "byte_size",
        "observed_byte_size",
        "sha256",
        "observed_sha256"
      ],
      "title": "SnapshotFileEntry",
      "type": "object"
    },
    "SnapshotReadOnlyTransition": {
      "additionalProperties": false,
      "properties": {
        "completed_offset_ns": {
          "exclusiveMinimum": 0,
          "title": "Completed Offset Ns",
          "type": "integer"
        },
        "started_offset_ns": {
          "minimum": 0,
          "title": "Started Offset Ns",
          "type": "integer"
        },
        "verification_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Evidence Sha256",
          "type": "string"
        },
        "verified_regular_file_count": {
          "const": 10,
          "title": "Verified Regular File Count",
          "type": "integer"
        },
        "writable_after": {
          "const": false,
          "title": "Writable After",
          "type": "boolean"
        },
        "writable_before": {
          "const": true,
          "title": "Writable Before",
          "type": "boolean"
        }
      },
      "required": [
        "started_offset_ns",
        "completed_offset_ns",
        "writable_before",
        "writable_after",
        "verified_regular_file_count",
        "verification_evidence_sha256"
      ],
      "title": "SnapshotReadOnlyTransition",
      "type": "object"
    },
    "SnapshotSpecialTokenIds": {
      "additionalProperties": false,
      "properties": {
        "bos_token_id": {
          "const": 151643,
          "title": "Bos Token Id",
          "type": "integer"
        },
        "eos_token_id": {
          "const": 151645,
          "title": "Eos Token Id",
          "type": "integer"
        },
        "pad_token_id": {
          "const": 151643,
          "title": "Pad Token Id",
          "type": "integer"
        },
        "unk_token_id": {
          "title": "Unk Token Id",
          "type": "null"
        }
      },
      "required": [
        "bos_token_id",
        "eos_token_id",
        "pad_token_id",
        "unk_token_id"
      ],
      "title": "SnapshotSpecialTokenIds",
      "type": "object"
    },
    "Stage2ProcessKind": {
      "enum": [
        "ONLINE_SNAPSHOT_DOWNLOAD",
        "OFFLINE_TOKENIZER_VERIFICATION",
        "OFFLINE_VLLM_RESTART_1",
        "OFFLINE_VLLM_RESTART_2",
        "OFFLINE_VLLM_RESTART_3"
      ],
      "title": "Stage2ProcessKind",
      "type": "string"
    },
    "Stage2ProcessOperation": {
      "additionalProperties": false,
      "properties": {
        "exact_network_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exact Network Source"
        },
        "exits_after_operation": {
          "title": "Exits After Operation",
          "type": "boolean"
        },
        "local_files_only": {
          "title": "Local Files Only",
          "type": "boolean"
        },
        "repository_id": {
          "anyOf": [
            {
              "const": "Qwen/Qwen2.5-0.5B-Instruct",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Repository Id"
        },
        "revision": {
          "anyOf": [
            {
              "const": "7ae557604adf67be50417f59c2c2f167def9a775",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision"
        },
        "token_false": {
          "title": "Token False",
          "type": "boolean"
        },
        "verified_local_snapshot_path": {
          "title": "Verified Local Snapshot Path",
          "type": "string"
        }
      },
      "required": [
        "token_false",
        "local_files_only",
        "repository_id",
        "revision",
        "exact_network_source",
        "verified_local_snapshot_path",
        "exits_after_operation"
      ],
      "title": "Stage2ProcessOperation",
      "type": "object"
    },
    "Stage2ProcessRecord": {
      "additionalProperties": false,
      "properties": {
        "absent_environment_variables": {
          "items": {
            "type": "string"
          },
          "title": "Absent Environment Variables",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "environment_capture_offset_ns": {
          "minimum": 0,
          "title": "Environment Capture Offset Ns",
          "type": "integer"
        },
        "first_relevant_import_offset_ns": {
          "exclusiveMinimum": 0,
          "title": "First Relevant Import Offset Ns",
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/Stage2ProcessOperation"
        },
        "process_identity": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Process Identity",
          "type": "string"
        },
        "process_kind": {
          "$ref": "#/$defs/Stage2ProcessKind"
        },
        "process_start_offset_ns": {
          "minimum": 0,
          "title": "Process Start Offset Ns",
          "type": "integer"
        }
      },
      "required": [
        "process_kind",
        "process_identity",
        "process_start_offset_ns",
        "environment_capture_offset_ns",
        "first_relevant_import_offset_ns",
        "environment",
        "absent_environment_variables",
        "operation"
      ],
      "title": "Stage2ProcessRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chat_template_absent": {
      "title": "Chat Template Absent",
      "type": "boolean"
    },
    "chat_template_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
