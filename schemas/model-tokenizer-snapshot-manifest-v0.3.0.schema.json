      "minItems": 1,
      "title": "Hf Local Metadata Inventory",
      "type": "array"
    },
    "license": {
      "const": "Apache-2.0",
      "title": "License",
      "type": "string"
    },
    "manifest_name": {
      "const": "model-tokenizer-snapshot-manifest-v0.3.0",
